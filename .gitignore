# Python
__pycache__/
*.pyc
*.pyo

# 파이프라인 대용량/중간 산출물 (사이트 미사용 — Supabase/로컬 보관)
data/*_members.json
data/legacy_S3/
data/legacy_pre_merge/

# 비공개 페이지 (배포 제외)
lab.html
policy.html

# 로컬 도구 설정 (Claude Code 미리보기 서버 등 — 배포 무관)
.claude/

# 백업·임시
*.bak
*_pre_*.json
tmp_*
.DS_Store
Thumbs.db

# 편집기 설정 (로컬 전용)
.vscode/

# 시군 브리프 출력 (발행 결정 전 — 생성기는 추적, 출력은 로컬)
briefs/

# 파이프라인 실행 로그 (재현 기록은 모델 저장소 쪽에 남는다)
pipeline/**/*.log

# API 키 등 로컬 비밀값 (README '외부 API 키')
.env
.env.*

# 내부 문서 — 저장소 루트가 곧 공개 Pages 이므로 올리지 않는다 (iCloud 보관)
REVIEW_*.md
REWORK_PLAN.md
docs/*HANDOFF*.md
docs/*EMAIL_DRAFT*.md
docs/*PLAN_*.md
docs/MAC_SETUP.md
docs/method_advisory/DELIVERABLES.md
